# Auto Pull Main configuration. Copy to the plugin config dir (herdr plugin
# config-dir bring-shrubbery.auto-pull-main) as config.env. Only AUTO_PULL_*
# KEY=VALUE lines are read; changes apply on the next poll without a restart.

# How often to poll. Accepts 300, 300s, 5m, 1h. Minimum 15s.
AUTO_PULL_INTERVAL=5m

# Remote to fetch from.
AUTO_PULL_REMOTE=origin

# Branch to keep up to date. Empty = auto-detect per repo: origin/HEAD, then
# main, master, trunk. Per-repo override: git config autoPullMain.branch <name>
AUTO_PULL_BRANCH=

# What counts as a clean checkout before fast-forwarding a checked-out branch:
#   tracked  - no staged or unstaged changes to tracked files (untracked files are fine)
#   all      - additionally no untracked files
#   none     - do not check; git itself still refuses conflicting fast-forwards
AUTO_PULL_REQUIRE_CLEAN=tracked

# Skip a checkout while a Herdr-detected agent in it is busy.
AUTO_PULL_SKIP_WHILE_AGENT_WORKING=true
# Herdr agent states that count as busy (comma separated): working, blocked, unknown, idle, done
AUTO_PULL_BUSY_AGENT_STATES=working

# When the branch is not checked out in any worktree (for example you work in
# worktrees and main is on a feature branch too), fast-forward the local ref
# directly so new worktrees start from fresh main.
AUTO_PULL_UPDATE_UNCHECKED_BRANCH=true

# Run `git submodule update --init --recursive` after a successful fast-forward.
AUTO_PULL_SUBMODULES=false

# Toast notifications for automatic runs: none | updates | errors | all
# Manual actions (pull-now / pull-here) always show a summary.
AUTO_PULL_NOTIFY=updates
# Sound for toasts: none | done | request
AUTO_PULL_NOTIFY_SOUND=none

# Seconds before a hung fetch is killed.
AUTO_PULL_FETCH_TIMEOUT=60

# Colon-separated glob lists matched against the primary checkout path.
# INCLUDE empty = every repo open in Herdr. EXCLUDE wins over INCLUDE.
# Example: AUTO_PULL_EXCLUDE=/Users/me/Projects/legacy:*/vendor/*
AUTO_PULL_INCLUDE=
AUTO_PULL_EXCLUDE=

# Seconds to wait after Herdr starts before the first pass.
AUTO_PULL_STARTUP_DELAY=10

# Rotate the log once it exceeds this many bytes.
AUTO_PULL_LOG_MAX_BYTES=1000000
